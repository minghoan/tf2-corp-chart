    },
    {
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "color-text" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Phase" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "Failed":    { "color": "red",    "index": 0, "text": "Failed"    },
                                 "Pending":   { "color": "yellow", "index": 1, "text": "Pending"   },
                                 "Running":   { "color": "green",  "index": 2, "text": "Running"   },
                                 "Succeeded": { "color": "blue",   "index": 3, "text": "Succeeded" },
                                 "Unknown":   { "color": "grey",   "index": 4, "text": "Unknown"   } },
                    "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "id": 41,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Phase" }]
      },
