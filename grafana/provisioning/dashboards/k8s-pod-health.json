      "type": "table",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "OOMKills", "container": "Container", "pod": "Pod", "namespace": "Namespace" } } }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "expr": "sum by (namespace, pod, container) (increase(kube_pod_container_status_last_terminated_reason{namespace=~\"$namespace\", pod=~\"$pod\", reason=\"OOMKilled\"}[1h])) > 0",
          "format": "table",
          "instant": true,
          "legendFormat": "",
