      "type": "table",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true }, "renameByName": { "namespace": "Namespace", "pod": "Pod", "phase": "Phase" } } }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "expr": "kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"$pod\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
